  "adoptedDecisions": [
    {
      "id": "mental-invisibility-third-stage-location",
      "question": "Q40",
      "status": "adopted",
      "source": "RE规则术语解释.md:177 对照 侦测与定位.md:38、65—72；幻身咒D精神.md:89",
      "issue": "术语解释明确无相应心灵免疫时第二阶段自动输、第三阶段通常照常；专门章节随后绝对写无法获得定位，与其保留第三阶段的前句及定位矩阵冲突。",
      "impact": "低阶心灵隐形下无心灵免疫者能否依技能对抗取得模糊定位，还是完全无法定位。",
      "decision": "无相应心灵免疫时第二阶段自动输，通常仍进行第三阶段；赢得第三阶段可在敏感范围取得模糊定位。B级以上心灵隐形且侦测等级不足时仍自动赢第三阶段。单纯提高侦测等级不突破第二阶段，也不自动授予视线或精确定位。",
      "adoption": "用户2026-10-26明确答复：“Q39 不能；Q40 可以”。"
    },
    {
      "id": "invisibility-rediscovery-after-hiding",
      "question": "Q41",
      "status": "adopted",
      "source": "RE D级通用魔法/幻术1.md:59；侦测与定位.md:17、65—70、139；规则术语解释.md:175",
      "issue": "隐形术增强措手不及针对“未发现其”的受害者；攻击后会得到模糊位置，移动可使旧位置失效，但没有写移动/重新躲藏会清除已经发现其存在的判定。",
      "impact": "决定同一场景中成功重新隐藏能否反复获得法术等级的增强措手不及；不能以当前none定位直接代替从未发现。",
      "decision": "保留发现历史：同场景已发现存在者，单纯移动或重新隐藏不恢复增强措手不及；未精确定位时仍可适用普通无支线隐形优势。明确遗忘/记忆改变另依有来源的效果。",
      "adoption": "用户2026-10-26明确答复：全部采用，继续推进（Q41/Q42/Q43）。"
    },
    {
      "id": "passive-concealment-movement-accumulation",
      "question": "Q43",
      "status": "adopted",
      "source": "RE侦测与定位.md:59、83；场景与动作.md:20—22；用户Q24/Q26的回合制周期采用记录",
      "issue": "被动条款仅写“在自己的行动中”移动超半速，每超1米躲藏−1且持续一轮，未明说单次移动动作还是本行动阶段累计；主动侦查则明确本回合和上回合总移动。这是距离取值窗口，不重问Q24/Q26中多个动作是否属于同一轮。",
      "impact": "标准动作转移动等连续移动时的隐藏减值，以及行动者/观察者先后顺序所用的保存期限不同；实际距离已能记录，不是尚未编程冒充缺参数。",
      "decision": "被动检定累计本角色本次行动阶段的主动移动，超过半速的累计米数产生减值，保留到该角色下次行动开始；主动侦查保留原文明示的本回合＋上回合总移动窗口。",
      "adoption": "用户2026-10-26明确答复：全部采用，继续推进（Q41/Q42/Q43）。"
    }
  ],
