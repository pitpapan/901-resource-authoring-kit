  "unresolvedRules": [
    {
      "id": "projection-apparent-damage-basis",
      "question": "Q51",
      "status": "pending",
      "source": "RE D级通用魔法/幻术1.md:77；同文件镜像:17；伤害处理流程.md:81–82",
      "issue": "C虚假幻象规定近战伤害/单次>P暴露触感异常，但无实体对象没有防御、豁免、防护数值。镜像继承真身的条款不能移用于本术。",
      "impact": "决定单体及范围伤害触感识破的基数；当前C攻击入口在扣费/抽骰前RULE_UNRESOLVED。",
      "recommendation": "独立幻象使用攻击方实际结算：攻击检定按静止无防护目标，定值范围按覆盖处原始伤害、不另造豁免/法抗；仅作识破阈值，不记真实HP、不触发伤害连锁。附着对象真实受伤仍走其正常防护，不把其结果借给幻象。"
    }
  ],
  "implementationGaps": [
    "基础程序、共享场景对象/操控/识破/时钟及MVU幂等已有专项；完整范围攻击、路径事件与声音传播、附着外观的同源选择、所有变体/交互仍待接，不能视为缺玩家参数。",
    "真实视觉只消费实际已登记senseSources.trueSight和敏感范围；取得链/全部感官派生尚未全覆盖。"
  ],
