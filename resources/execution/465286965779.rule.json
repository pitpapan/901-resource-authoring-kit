  "adoptedDecisions": [
    {
      "id": "time-slow-initial-phase",
      "question": "Q24",
      "source": "用户2026-10-25修改Q24：开启那一轮作为六秒周期的开头，以回合制战斗为主",
      "rule": "战斗中开启减速的当轮统一作为新的六秒周期起点，不保留此前周期进度，以回合为主而非动作内连续秒数。回合开始/结束伤害在各自边界采样；C级2倍周期的轮末伤害在开启轮末进度为1/2、下一轮末触发，轮首伤害在第二个后续轮首触发。",
      "rejectedAlternative": "战斗中保留开启前连续秒数比例（原推荐未采用）"
    },
    {
      "id": "time-slow-ending-phase",
      "question": "Q25",
      "source": "用户2026-10-25 Q25采用",
      "rule": "减速只改变持续伤害触发周期，不产生待补伤害债务。伤害来源结束取消其未触发周期；减速结束保留周期完成比例并恢复正常速度，不立即补伤；痛苦诅咒等明确要求结束结清的条款优先。"
    },
    {
      "id": "time-haste-round-charge",
      "question": "Q26",
      "source": "用户2026-10-25：按回合制，先标准动作再移动施法也算一轮；类似问题无需再问",
      "rule": "启用且实际生效的当轮计1轮，同轮不因先后动作顺序、重复采样或恢复旧实例而重复计数；后续实际生效轮各计1轮。不可行动不免除，真正结束时统一承受已记不可避免A伤。"
    },
    {
      "id": "time-haste-suppressed-charge",
      "question": "Q27",
      "source": "用户2026-10-25采用",
      "rule": "被覆盖期间不新增代价，保留旧债；恢复后继续按实际生效轮计数，覆盖不是结束，真正结束才结清。"
    },
    {
      "id": "physical-action-missing-raw-ap",
      "question": "Q28",
      "source": "用户2026-10-26明确“采用Q28，Q29，继续”；原文依据：901规则快照§4；PHB 非战斗行动与战斗行动；RE辅助动作.md:10、18–26，防御类动作.md:18–31，常用动作.md:149–151；00-施法通则.md:30–44",
      "rule": "明示且与现行一致的原AP优先（已确认持武5、移动4、肉搏6、拔武器4、上箭2、普通格挡4）；无原AP或原RE价与现行冲突时，只为调价采用现有实际动作槽对应档位上界：迅捷2、移动4、标准6、标准＋迅捷8、标准＋移动10、三槽全用12。不改变未调价动作、不引入AP池，明确个别适配优先。"
    },
    {
      "id": "free-physical-action-price-scope",
      "question": "Q29",
      "source": "用户2026-10-26明确“采用Q28，Q29，继续”；原文依据：901规则快照§4自由/借机；00-施法通则.md:42、44；时间魔术正文每轮第一次身体行动",
      "rule": "原本免费的身体行动保持免费，不参与加减价，也不消耗每轮一次的调价额度；额度留给本轮第一个适用的有价身体行动。借机攻击仍遵守既有时机/次数，不增加次数。"
    }
