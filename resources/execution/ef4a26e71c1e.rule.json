  "unresolvedRules": [
    {
      "id": "projection-trigger-sensory-policy",
      "question": "Q50",
      "status": "pending",
      "source": "RE C级通用魔法/幻术2.md:18；侦测与定位.md:22、115",
      "issue": "触发要求设置点范围内可见/可听事件，但未赋予观察者属性、侦测等级、黑暗视觉或穿墙听觉。",
      "impact": "黑暗、隐形/反侦测、墙后声音的自动触发不能默认成功，也不能继承施法者特殊感官。",
      "recommendation": "独立按设置点普通视觉/听觉判断，不继承施法者特殊感官；黑暗或未显露的隐形事件不作视觉触发，声音依正常传播。需要确认可察觉性时使用有来源的现场事件事实，不凭空给幻影人物骰池或读取隐藏身份。"
    }
  ],
  "implementationGaps": [
    "基础程序、共享场景对象/操控/识破/时钟及MVU幂等已有专项；完整范围攻击、路径事件与声音传播、附着外观的同源选择、所有变体/交互仍待接，不能视为缺玩家参数。",
    "真实视觉只消费实际已登记senseSources.trueSight和敏感范围；取得链/全部感官派生尚未全覆盖。"
  ],
