  "adoptedDecisions": [
    {
      "id": "illusion-interaction-witnesses",
      "question": "Q48",
      "status": "adopted",
      "source": "RE D级幻术1.md:72、77；C级幻术2.md:19；幻术.md:15、21；侦测与定位.md:35–41、94、109",
      "issue": "物理穿透会让人直接识破/暴露，未明确实际目击穿透者是否自动获得识破；定位分享不等于识破传播。",
      "impact": "决定互动发生后哪些实际观察者的实例识破账更新，不能因此删除全场幻象。",
      "decision": "互动者和以实际感官明确观察到穿透矛盾的旁观者自动识破；口头告知、仅收到定位者不自动识破。C虚假幻象仅由互动者感到的触感异常不传播给未观察到矛盾的旁观者。",
      "adoption": "用户2026-10-26明确答复：采用，继续（Q48/Q49）。"
    },
    {
      "id": "programmed-illusion-recognition-retries",
      "question": "Q49",
      "status": "adopted",
      "source": "RE C级幻术2.md:17、20；技能概述.md:136–138；调查.md:51、88；侦测与定位.md:80",
      "issue": "看到或听到时可一次检定，技能默认允许重试；循环播放未明确免费机会重置和同次播放主动重试的边界。",
      "impact": "决定activationId下每位观察者的免费机会、主动动作计费和骰流去重，不允许视觉/听觉各领一次免费骰。",
      "decision": "每次新播放给尚未识破者一次被动检定；视觉/听觉按实际可用感官选一，共用一次机会。同次播放不逐轮免费重掷，可付主动观察的4AP（901移动动作）重试；成功的实例识破持续，不因潜伏重置。",
      "adoption": "用户2026-10-26明确答复：采用，继续（Q48/Q49）。"
    }
  ]
