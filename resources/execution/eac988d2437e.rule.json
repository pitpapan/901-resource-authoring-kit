  "scopeNotes": [
    "本人攻击防护后造成伤害才产生追加，临时生命不否决；全部转成非伤害效果不产生追加。追加先收集后与原伤害共同进入生命处理，不重复同类型已经消费的防护，不递归追加、不套普通攻击伤害转换。RE伤害处理流程59、61、93—95。"
  ],
  "adoptedDecisions": [
    {
      "id": "legacy-shared-mixed-same-type-damage",
      "question": "Q30",
      "status": "adopted",
      "source": "901-core-rules-v0.1.md:80保留原来源分段/触发；原卡资料集_检索版:822—824雷鸣剑将原伤部分转电击；RE伤害处理流程:59、89、91、93—95",
      "issue": "旧901同一次共享防护攻击可有物理和电击分段，但仍只产生一份P+1同类附伤。RE定义的同时多类型或独立伤害事件都不直接对应这项保留结构。",
      "impact": "全归物理、按防护后分段比例分配或每种各一份会产生不同结果；不能擅自多次触发或把每点变同时物理且电击。",
      "adoption": "用户本轮“全部采用，继续”，采用Q30。",
      "decision": "保持一份总额，按原攻击防护后仍存各类型伤害比例分配整数点，先向下取整、余点按小数部分从大到小分配；余点并列由攻击前声明的类型顺序决定。各分量取本类型最轻伤型，复用同类型已使用防护。已采用。"
    }
  ]
