{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "901 paired resource contract",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "version",
    "identity",
    "reading",
    "definition",
    "clauses",
    "actions",
    "inputs",
    "unresolvedRules",
    "implementationGaps",
    "verification"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "901-resource/1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "identity": {
      "type": "object",
      "required": [
        "name",
        "grade",
        "category",
        "tree"
      ]
    },
    "reading": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "heading": {
          "type": "string"
        },
        "headingDepth": {
          "enum": [
            2,
            3
          ]
        }
      },
      "additionalProperties": false
    },
    "definition": {
      "type": "object",
      "properties": {
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "programs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/program"
          }
        }
      }
    },
    "clauses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "heading",
          "effectStats",
          "status"
        ],
        "properties": {
          "heading": {
            "type": "string"
          },
          "effectStats": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "implemented",
              "partial",
              "pending",
              "rule-unresolved"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "operation",
          "actionCost",
          "requiredChoice",
          "requestFields",
          "allowsModelNumericEffects"
        ],
        "properties": {
          "allowsModelNumericEffects": {
            "const": false
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "provider",
          "requiredFor",
          "missingPolicy"
        ],
        "properties": {
          "provider": {
            "enum": [
              "saved-state",
              "player",
              "host"
            ]
          }
        }
      }
    },
    "unresolvedRules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "parameter",
          "basis",
          "recommendation"
        ],
        "properties": {
          "parameter": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "string",
            "minLength": 1
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "implementationGaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "status",
        "sourceChecked",
        "runtimeFullyVerified"
      ],
      "properties": {
        "status": {
          "enum": [
            "partial",
            "verified",
            "pending"
          ]
        },
        "sourceChecked": {
          "type": "boolean"
        },
        "runtimeFullyVerified": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "effect": {
      "type": "object",
      "required": [
        "stat",
        "value"
      ],
      "properties": {
        "stat": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/value"
        },
        "stacking": {
          "const": "add"
        },
        "group": {
          "type": "string"
        },
        "when": {
          "$ref": "#/$defs/condition"
        }
      }
    },
    "value": {
      "oneOf": [
        {
          "type": [
            "number",
            "boolean",
            "string",
            "null"
          ]
        },
        {
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "type": "string"
            },
            "default": {}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "context"
          ],
          "properties": {
            "context": {
              "type": "string"
            },
            "default": {}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "enum": [
                "add",
                "sub",
                "mul",
                "div",
                "min",
                "max",
                "floor"
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/value"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "conditionValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/value"
        },
        {
          "type": "object",
          "required": [
            "snapshot"
          ],
          "properties": {
            "snapshot": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "condition": {
      "type": "object",
      "properties": {
        "all": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "any": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "not": {
          "$ref": "#/$defs/condition"
        },
        "test": {
          "enum": [
            "eq",
            "ne",
            "gte",
            "lte",
            "in",
            "contains",
            "present"
          ]
        },
        "left": {
          "$ref": "#/$defs/conditionValue"
        },
        "right": {
          "$ref": "#/$defs/conditionValue"
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "enum": [
            "save",
            "attack",
            "damage",
            "status",
            "heal",
            "removeStatus",
            "effect",
            "capability",
            "trigger",
            "inspect",
            "observe",
            "setFact",
            "removeEntries",
            "stabilize"
          ]
        },
        "when": {
          "$ref": "#/$defs/condition"
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "save"
              }
            }
          },
          "then": {
            "required": [
              "type"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "attack"
              }
            }
          },
          "then": {
            "required": [
              "weapon"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "damage"
              }
            }
          },
          "then": {
            "required": [
              "amount"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "status"
              }
            }
          },
          "then": {
            "required": [
              "type",
              "points"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "heal"
              }
            }
          },
          "then": {
            "required": [
              "amount"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "removeStatus"
              }
            }
          },
          "then": {
            "required": [
              "amount"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "effect"
              }
            }
          },
          "then": {
            "required": [
              "effects"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "capability"
              }
            }
          },
          "then": {
            "required": [
              "id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "trigger"
              }
            }
          },
          "then": {
            "required": [
              "event",
              "steps"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "inspect"
              }
            }
          },
          "then": {
            "required": [
              "stat"
            ]
          }
        }
      ]
    },
    "program": {
      "type": "object",
      "required": [
        "action",
        "target",
        "steps"
      ],
      "properties": {
        "action": {
          "oneOf": [
            {
              "enum": [
                "standard",
                "move",
                "swift",
                "free",
                "reflex"
              ]
            },
            {
              "type": "array",
              "items": {
                "enum": [
                  "standard",
                  "move",
                  "swift",
                  "free",
                  "reflex"
                ]
              },
              "minItems": 1
            }
          ]
        },
        "target": {
          "enum": [
            "single",
            "self",
            "multiple",
            "area"
          ]
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "choices": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "values"
            ],
            "properties": {
              "values": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true
              }
            }
          }
        },
        "ignoreSpellResistance": {
          "type": "boolean"
        },
        "repetition": {
          "type": "object",
          "anyOf": [
            {
              "required": [
                "count"
              ]
            },
            {
              "required": [
                "maximum"
              ]
            }
          ],
          "properties": {
            "count": {
              "$ref": "#/$defs/value"
            },
            "maximum": {
              "$ref": "#/$defs/value"
            },
            "extraCost": {
              "$ref": "#/$defs/value"
            },
            "extraCondition": {
              "$ref": "#/$defs/condition"
            }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
