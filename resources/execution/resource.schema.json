{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "901 paired resource contract",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "version",
    "identity",
    "reading",
    "definition",
    "clauses",
    "actions",
    "inputs",
    "unresolvedRules",
    "implementationGaps",
    "verification"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "901-resource/1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "identity": {
      "type": "object",
      "required": [
        "name",
        "grade",
        "category",
        "tree"
      ]
    },
    "reading": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "heading": {
          "type": "string"
        },
        "headingDepth": {
          "enum": [2,3]
        }
      },
      "additionalProperties": false
    },
    "definition": {
      "type": "object",
      "properties": {
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        }
      }
    },
    "clauses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "heading",
          "effectStats",
          "status"
        ],
        "properties": {
          "heading": {
            "type": "string"
          },
          "effectStats": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "implemented",
              "partial",
              "pending",
              "rule-unresolved"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "operation",
          "actionCost",
          "requiredChoice",
          "requestFields",
          "allowsModelNumericEffects"
        ],
        "properties": {
          "allowsModelNumericEffects": {
            "const": false
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "provider",
          "requiredFor",
          "missingPolicy"
        ],
        "properties": {
          "provider": {
            "enum": [
              "saved-state",
              "player",
              "host"
            ]
          }
        }
      }
    },
    "unresolvedRules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "parameter",
          "basis",
          "recommendation"
        ]
      }
    },
    "implementationGaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "status",
        "sourceChecked",
        "runtimeFullyVerified"
      ],
      "properties": {
        "status": {
          "enum": [
            "partial",
            "verified",
            "pending"
          ]
        },
        "sourceChecked": {
          "type": "boolean"
        },
        "runtimeFullyVerified": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "effect": {
      "type": "object",
      "required": [
        "stat",
        "value"
      ],
      "properties": {
        "stat": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/value"
        },
        "stacking": {
          "const": "add"
        },
        "group": {
          "type": "string"
        }
      }
    },
    "value": {
      "oneOf": [
        {
          "type": [
            "number",
            "boolean",
            "string",
            "null"
          ]
        },
        {
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "type": "string"
            },
            "default": {}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "context"
          ],
          "properties": {
            "context": {
              "type": "string"
            },
            "default": {}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "enum": [
                "add",
                "sub",
                "mul",
                "div",
                "min",
                "max",
                "floor"
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/value"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
